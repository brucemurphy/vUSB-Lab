<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="vUSB_LAB.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:vUSB_LAB">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#FFFFC700</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFFD43B</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFFDF70</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFEDAC</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFFC700" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFFFD43B" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFE0AE00" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF101318" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FF242A34" />
            <SolidColorBrush x:Key="LabCardBrush" Color="#FF171C23" />
            <SolidColorBrush x:Key="LabStrokeBrush" Color="#FF282F3B" />
            <Style x:Key="LabCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource LabCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LabStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="LabSectionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FF97A6B7" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="100" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
